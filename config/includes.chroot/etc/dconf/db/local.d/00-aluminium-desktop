# Aluminium OS / Googlebook OS Material 3 Profile
# Complete Desktop, Window Controls, Snapping, Top Bar & Floating Shelf configuration

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Aluminium-Material'
icon-theme='Papirus-Dark'
font-name='Roboto 10'
document-font-name='Roboto 10'
monospace-font-name='Roboto Mono 10'
cursor-theme='Adwaita'
cursor-size=24
clock-format='24h'
clock-show-weekday=true
show-battery-percentage=true
enable-animations=true

[org/gnome/desktop/wm/preferences]
theme='Aluminium-Material'
titlebar-font='Roboto Bold 10'
button-layout=':minimize,maximize,close'
action-double-click-titlebar='toggle-maximize'
action-middle-click-titlebar='lower'
action-right-click-titlebar='menu'
focus-mode='click'
auto-raise=true

[org/gnome/mutter]
center-new-windows=true
attach-modal-dialogs=true
dynamic-workspaces=true
edge-tiling=true
experimental-features=['scale-monitor-framebuffer']

[org/gnome/desktop/wm/keybindings]
maximize=['<Super>Up']
unmaximize=['<Super>Down']
minimize=['<Super>h']
close=['<Alt>F4', '<Super>q', '<Super>w']
toggle-fullscreen=['F11']
toggle-maximized=['<Super>m']

[org/gnome/mutter/keybindings]
toggle-tiled-left=['<Super>Left']
toggle-tiled-right=['<Super>Right']

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/aluminium/aluminium-dark.png'
picture-uri-dark='file:///usr/share/backgrounds/aluminium/aluminium-dark.png'
picture-options='zoom'
primary-color='#131518'
secondary-color='#131518'

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.ControlCenter.desktop']

[org/gnome/shell/extensions/user-theme]
name='Aluminium-Material'

# Dash to Dock (Configured as Floating Pill Shelf / Android Desktop Dock)
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
dash-max-icon-size=48
icon-size-fixed=true
custom-theme-shrink=true
custom-background-color=true
background-color='#181a1f'
background-opacity=0.85
transparency-mode='FIXED'
running-indicator-style='DOTS'
running-indicator-dominant-color=true
show-show-apps-button=true
show-apps-at-top=true
show-apps-icon-file='/usr/share/icons/aluminium/google-g.svg'
isolate-workspaces=false
middle-click-action='launch'
shift-click-action='minimize'
animate-show-apps=true
apply-custom-theme=true

# Dash to Panel fallback compatibility (if dash-to-panel is used instead)
[org/gnome/shell/extensions/dash-to-panel]
panel-position='BOTTOM'
panel-size=48
panel-lengths='{"0":100}'
dot-position='BOTTOM'
dot-style-focused='DOTS'
dot-style-unfocused='DOTS'
dot-color-dominant=true
dot-size=4
hot-keys=false
show-apps-icon-file='/usr/share/icons/aluminium/google-g.svg'
show-show-apps-button=true
show-apps-button-at-end=false
isolate-workspaces=false
middle-click-action='LAUNCH-NEW-INSTANCE'
shift-click-action='MINIMIZE'
appicon-margin=6
appicon-padding=8
tray-padding=10
status-icon-padding=6
trans-use-custom-opacity=true
trans-panel-opacity=0.85
trans-use-custom-bg=true
trans-custom-bg-color='#181a1f'
animate-appicon-hover=true
